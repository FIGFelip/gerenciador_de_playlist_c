# Makefile para compilar e executar testes

CC      = gcc
CFLAGS  = -Wall -Wextra -g3 -Iinclude

TEST_SRC = tests/test_playlist.c src/playlist.c src/inserir.c src/remover.c src/navegacao.c
TEST_OBJ = $(TEST_SRC:.c=.o)
TEST_TARGET = tests/test_playlist

all: $(TEST_TARGET)

$(TEST_TARGET): $(TEST_OBJ)
	$(CC) $(CFLAGS) $^ -o $@

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

run: $(TEST_TARGET)
	./$(TEST_TARGET)

clean:
	rm -f $(TEST_OBJ) $(TEST_TARGET)

.PHONY: all clean run